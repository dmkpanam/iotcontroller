APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./home_controller.db
API_HOST=127.0.0.1
API_PORT=8000
WEATHER_PROVIDER=openweathermap
WEATHER_API_KEY=
WEATHER_LATITUDE=53.593
WEATHER_LONGITUDE=-2.298
WEATHER_TEMPERATURE_UNIT=celsius
WEATHER_WIND_SPEED_UNIT=kmh
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_TIMEOUT_SECONDS=5
LOCATION_NAME=Bury, Greater Manchester, UK
LOCATION_TIMEZONE=Europe/London
ENVIRONMENT_SOURCE_DEVICE_ID=
TELEMETRY_FRESHNESS_SECONDS=1800
WASTE_PROVIDER=manual
WASTE_POSTCODE=
WASTE_ADDRESS=
WASTE_MANUAL_SCHEDULE=[]
WASTE_CACHE_TTL_SECONDS=3600
WASTE_TIMEOUT_SECONDS=10
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_AUTH_METHOD=oauth
GOOGLE_CALENDAR_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_AUTH_METHOD=service_account
GOOGLE_CALENDAR_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
GOOGLE_CALENDAR_CACHE_TTL_SECONDS=300
GOOGLE_CALENDAR_TIMEOUT_SECONDS=10
REQUEST_BODY_LIMIT_BYTES=16384
